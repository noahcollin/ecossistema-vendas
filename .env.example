# Credenciais do Banco de Dados PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ecossistema_vendas

# URL do Redis para controle de Filas e Cadência
REDIS_URL=redis://redis:6379/0

# ----------------- UAZAPI (WHATSAPP) -----------------
UAZAPI_URL=https://inteligentte.uazapi.com
UAZAPI_TOKEN=sua_chave_secreta_aqui

# ----------------- OPENAI (CÉREBRO) -----------------
OPENAI_API_KEY=sua_chave_da_openai_aqui

# ----------------- SEGURANÇA E OPERAÇÃO -----------------
SANDBOX_MODE=true
WHITELIST_PHONE_SUFFIX=91923098
WEBHOOK_SECRET_TOKEN=
CORS_ORIGINS=*
LOG_LEVEL=INFO
DEBOUNCE_SECONDS=4.5

# ----------------- FINOPS E ROTEAMENTO DE MODELOS -----------------
DYNAMIC_MODEL_ROUTING=true
MODEL_CLOSER_FAST=gpt-4o-mini
MODEL_CLOSER_ADVANCED=gpt-4o
MODEL_ANALYZER=gpt-4o-mini
MODEL_AUDITOR=gpt-4o-mini
CONCURRENCY_SEMAPHORE_LIMIT=30
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_RETRIES=2

# ----------------- MOTOR DE CADÊNCIA E FOLLOW-UP (RF11 & RF12) -----------------
FOLLOWUP_ENABLED=true
FOLLOWUP_INTERVAL_1_HOURS=2.0
FOLLOWUP_INTERVAL_2_HOURS=24.0
FOLLOWUP_INTERVAL_3_HOURS=72.0
BUSINESS_HOURS_START=08:30
BUSINESS_HOURS_END=18:30
BUSINESS_HOURS_SATURDAY_START=09:00
BUSINESS_HOURS_SATURDAY_END=12:30

# ----------------- ANTI-BAN & HUMAN PACING (WHATSAPP) -----------------
FOLLOWUP_PACING_MIN_SECONDS=30.0
FOLLOWUP_PACING_MAX_SECONDS=60.0
FOLLOWUP_JITTER_STEP_MINUTES=3.0
FOLLOWUP_SIMULAR_DIGITACAO=true

# ----------------- TRANSBORDO HUMANO & SUPERVISÃO (RF10) -----------------
SUPERVISOR_PHONE=+5583999999999
TRANSBORDO_WEBHOOK_URL=
TRANSBORDO_VIP_VALOR_MIN=10000.0
TRANSBORDO_ENVIAR_MENSAGEM_CLIENTE=false
TRANSBORDO_INACTIVITY_TIMEOUT_MINUTES=60

