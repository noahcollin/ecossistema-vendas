# Credenciais do Banco de Dados PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ecossistema_vendas

# URL do Redis para controle de Filas e Cadência
REDIS_URL=redis://redis:6379/0

# ----------------- UAZAPI (WHATSAPP) -----------------
UAZAPI_URL=https://inteligentte.uazapi.com
UAZAPI_TOKEN=sua_chave_secreta_aqui

# ----------------- OPENAI (CÉREBRO) -----------------
OPENAI_API_KEY=sua_chave_da_openai_aqui

# ----------------- SEGURANÇA E OPERAÇÃO -----------------
SANDBOX_MODE=true
WHITELIST_PHONE_SUFFIX=91923098
WEBHOOK_SECRET_TOKEN=

# ----------------- FINOPS E ROTEAMENTO DE MODELOS -----------------
DYNAMIC_MODEL_ROUTING=true
MODEL_CLOSER_FAST=gpt-4o-mini
MODEL_CLOSER_ADVANCED=gpt-4o
CONCURRENCY_SEMAPHORE_LIMIT=30
